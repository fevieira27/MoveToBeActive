# Exclude weather functions for watches that do not support it
fenix5plus.excludeAnnotations = square;crossover;lowColors;LEDcolors;tempo
fenix5splus.excludeAnnotations = square;crossover;lowColors;LEDcolors;tempo
fenix5xplus.excludeAnnotations = square;crossover;lowColors;LEDcolors;tempo

# Exclude round hashmark logic for square models (to save memory and improve performance).
